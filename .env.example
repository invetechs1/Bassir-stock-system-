# Copy to .env and adjust. Used by docker-compose and the server.

# REQUIRED in production: secret used to sign JWTs (min 16 chars).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Price simulator tick interval, in milliseconds.
TICK_MS=3000

# How often each account's net worth is snapshotted for the chart, in ms.
SNAPSHOT_MS=60000

# Virtual cash granted to each new account.
STARTING_CASH=100000

# Allowed CORS origins: "*" or a comma-separated list of URLs.
CORS_ORIGIN=*

# Host port the web client is published on (docker-compose).
WEB_PORT=8080

# ============================================================================
# Autonomous trading agents (Binance)
# ============================================================================
# The 7-agent fleet + risk manager. Requires OUTBOUND network access to Binance
# for market data (and, in live mode, order placement).

# Who may control agents: comma-separated emails. Leave empty and the first
# registered account (the owner) is the sole admin.
ADMIN_EMAILS=

# paper  = fills simulated in-process against real Binance prices (no keys,
#          no funds at risk). This is the default and where you should live
#          until a strategy is proven.
# live   = real MARKET orders sent to BINANCE_BASE_URL. Also requires
#          LIVE_CONFIRM below and API keys.
TRADING_MODE=paper

# Safety gate: live trading is REFUSED unless this is exactly the phrase below.
# LIVE_CONFIRM=I_UNDERSTAND_THE_RISKS
LIVE_CONFIRM=

# Binance REST base for ORDERS. Defaults to the Spot Testnet (real data, fake
# balances). Point at https://api.binance.com only when you truly go live.
BINANCE_BASE_URL=https://testnet.binance.vision
# Public market-DATA base (klines/prices); mainnet has the fullest history.
BINANCE_DATA_URL=https://api.binance.com
# API credentials. Testnet keys: https://testnet.binance.vision/ (paper needs
# none). NEVER commit real keys — keep them only in your local .env / secrets.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- US stocks via Alpaca (paper trades real market data with fake money) ---
# Free paper keys: https://alpaca.markets/  (Alpaca DATA requires keys even in
# paper mode, so the US-equity fleet is inactive until these are set.)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Order endpoint: paper by default. For LIVE US trading set this to
# https://api.alpaca.markets AND enable the live gate (TRADING_MODE/LIVE_CONFIRM).
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Which agent fleets to run: any of 'crypto' (Binance, 24/7) and 'us_equity'
# (Alpaca, US market hours). Comma-separated.
AGENT_FLEETS=crypto,us_equity

# Quote asset the CRYPTO agents trade against (BTC/USDT, ETH/USDT, ...).
QUOTE_ASSET=USDT
# Capital allocated to EACH agent, in the quote asset.
AGENT_ALLOCATION=50
# How often the engine polls the market and agents decide, in ms.
AGENT_TICK_MS=15000
# Candle interval agents analyze (Binance kline interval).
AGENT_CANDLE_INTERVAL=1m
# Assumed taker fee per fill (fraction). 0.001 = 0.1%.
AGENT_FEE_RATE=0.001
# Start the engine on boot. Off by default; agents also start disabled.
ENGINE_AUTOSTART=false

# --- Risk limits (enforced by the top-level risk manager) -------------------
# Disable an agent when equity falls this % below its peak.
RISK_MAX_DRAWDOWN_PCT=20
# Halt an agent for the day after losing this % of its start-of-day equity.
RISK_DAILY_LOSS_LIMIT_PCT=10
# Cap on total capital deployed across all agents at once (quote asset).
RISK_MAX_TOTAL_EXPOSURE=400
# Max fraction of its allocation one agent may hold (1 = 100%).
RISK_MAX_POSITION_FRACTION=1
# Minimum order notional; smaller proposals are skipped as dust.
RISK_MIN_ORDER_NOTIONAL=1
